# Copy this file to .env.local and fill in values.
# .env.local is git-ignored — never commit tokens.

# page = Power 91 Page. profile = personal timeline trial (User token, publish_video).
FACEBOOK_LIVE_SOURCE=page
FACEBOOK_PAGE_ID=100063770387140
FACEBOOK_ACCESS_TOKEN=
