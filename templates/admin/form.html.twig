{% extends 'admin/base.html.twig' %}

{% block title %}{{ heading }}{% endblock %}

{% block admin %}
    <header class="admin-top">
        <div>
            <h1>{{ heading }}</h1>
            <p>This saves straight to the public site.</p>
        </div>
    </header>
    {{ form_start(form, {attr: {class: 'contact-form admin-form'}}) }}
        {{ form_widget(form) }}
        <div class="admin-row-actions">
            <button class="play-btn" type="submit">Save</button>
            <a href="{{ cancelPath }}">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
